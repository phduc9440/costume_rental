# ==============================================
# Environment Variables Template
# Copy this file to .env and fill in the values
# ==============================================

# --- General ---
COMPOSE_PROJECT_NAME=microservices-assignment
ENVIRONMENT=development

# --- Database (adjust to your chosen DB) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=admin
DB_PASSWORD=changeme

# --- Service Ports ---
CUSTOMER_SERVICE_PORT=5001
COSTUME_SERVICE_PORT=5002
SUPPLIER_SERVICE_PORT=5003
RENTAL_SERVICE_PORT=5004
RETURN_SERVICE_PORT=5005
GATEWAY_PORT=8080
FRONTEND_PORT=5173
EUREKA_PORT=9999
CONFIG_SERVER_PORT=8888

# --- API Gateway ---
GATEWAY_SECRET=your-gateway-secret

# --- Add more variables as needed for your stack ---
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://localhost:5672
# JWT_SECRET=your-jwt-secret
